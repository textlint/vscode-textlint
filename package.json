{
  "name": "textlint",
  "displayName": "textlint",
  "version": "0.13.0",
  "description": "Integrates textlint into VS Code.",
  "categories": [
    "Linters"
  ],
  "homepage": "https://github.com/textlint/vscode-textlint",
  "bugs": {
    "url": "https://github.com/textlint/vscode-textlint/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/textlint/vscode-textlint"
  },
  "license": "MIT",
  "publisher": "3w36zj6",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "rspack build --mode production",
    "clean": "rimraf dist out",
    "fix": "run-s format:write lint:fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepackage": "npm run build",
    "package": "vsce package --no-dependencies",
    "sort": "sort-package-json",
    "pretest": "rimraf dist && npm run type-check && npm run build",
    "test": "node ./tests/runTest.ts",
    "tsc": "tsc -p ./",
    "type-check": "tsc --noEmit",
    "upgrade": "ncu -u",
    "watch": "rspack build --mode development --watch"
  },
  "contributes": {
    "commands": [
      {
        "title": "Fix all auto-fixable Problems",
        "category": "textlint",
        "command": "textlint.executeAutofix"
      },
      {
        "title": "Create '.textlintrc' File",
        "category": "textlint",
        "command": "textlint.createConfig"
      },
      {
        "title": "Show Output Channel",
        "category": "textlint",
        "command": "textlint.showOutputChannel"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "textlint",
      "properties": {
        "textlint.languages": {
          "default": [
            "markdown",
            "plaintext",
            "html",
            "tex",
            "latex",
            "doctex"
          ],
          "type": [
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Languages to lint with textlint."
        },
        "textlint.configPath": {
          "type": "string",
          "default": null,
          "description": "An absolute path to textlint config file."
        },
        "textlint.ignorePath": {
          "type": "string",
          "default": null,
          "description": "An absolute path to textlint ignore file."
        },
        "textlint.nodePath": {
          "type": "string",
          "default": null,
          "description": "A path added to NODE_PATH when resolving the textlint module."
        },
        "textlint.run": {
          "type": "string",
          "enum": [
            "onSave",
            "onType"
          ],
          "default": "onSave",
          "description": "Run the linter on save (onSave) or on type (onType)"
        },
        "textlint.autoFixOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Turns auto fix on save on or off."
        },
        "textlint.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VSCode and the textlint linter service."
        },
        "textlint.targetPath": {
          "type": "string",
          "default": "",
          "description": "Target files path that runs lint."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        ".textlintrc.json": "jsonc",
        ".textlintignore": "ignore"
      }
    }
  },
  "activationEvents": [
    "onLanguage"
  ],
  "dependencies": {
    "minimatch": "^10.2.5",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.1.5",
    "@rspack/core": "^2.1.5",
    "@textlint/types": "^15.7.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "npm-check-updates": "^22.2.9",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sort-package-json": "^4.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "npm@12.0.1+sha512.2f94fd8bf600416416a934bfc59c4991e8bff7372ef7d842784e2a8b8d48c81555ee645069ddea73625fb8e92dc261feab0188fd5dab6c22fefd46316f5f9140",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "vscode": "^1.100.0"
  },
  "icon": "textlint-icon_128x128.png",
  "galleryBanner": {
    "color": "#5acbe3",
    "theme": "light"
  }
}
