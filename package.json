{
  "name": "textlint",
  "displayName": "textlint",
  "version": "0.13.0",
  "description": "Integrates textlint into VS Code.",
  "categories": [
    "Linters"
  ],
  "homepage": "https://github.com/textlint/vscode-textlint",
  "bugs": {
    "url": "https://github.com/textlint/vscode-textlint/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/textlint/vscode-textlint"
  },
  "publisher": "3w36zj6",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "rimraf dist out",
    "tsc": "tsc -p ./",
    "type-check": "tsc --noEmit",
    "build": "rspack build --mode production",
    "watch": "rspack build --mode development --watch",
    "pretest": "rimraf dist && npm run type-check && npm run build",
    "test": "node ./tests/runTest.ts",
    "format": "oxfmt --config oxfmt.config.ts --check",
    "format:write": "oxfmt --config oxfmt.config.ts --write",
    "lint": "oxlint --config oxlint.config.ts --type-aware",
    "lint:fix": "oxlint --config oxlint.config.ts --type-aware --fix",
    "textlint": "textlint README.md --format pretty-error",
    "textlint:fix": "textlint --fix README.md",
    "fix": "run-s format:write lint:fix",
    "sort": "sort-package-json",
    "upgrade": "ncu -u",
    "prepackage": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "minimatch": "^3.0.4",
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.1.1",
    "@rspack/core": "^2.1.1",
    "@textlint/types": "^15.7.1",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "merge-options": "^3.0.4",
    "npm-check-updates": "^11.8.5",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^3.0.2",
    "sort-package-json": "^1.52.0",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.2.2",
    "textlint-rule-prh": "^6.0.0",
    "textlint-rule-rousseau": "^1.4.8",
    "textlint-rule-unexpanded-acronym": "^1.2.4",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "title": "Create '.textlintrc' File",
        "category": "textlint",
        "command": "textlint.createConfig"
      },
      {
        "title": "Show Output Channel",
        "category": "textlint",
        "command": "textlint.showOutputChannel"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        ".textlintrc.json": "jsonc",
        ".textlintignore": "ignore"
      }
    },
    "configuration": {
      "type": "object",
      "title": "textlint",
      "properties": {
        "textlint.languages": {
          "default": [
            "markdown",
            "plaintext",
            "html",
            "tex",
            "latex",
            "doctex"
          ],
          "type": [
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Languages to lint with textlint."
        },
        "textlint.configPath": {
          "type": "string",
          "default": null,
          "description": "An absolute path to textlint config file."
        },
        "textlint.ignorePath": {
          "type": "string",
          "default": null,
          "description": "An absolute path to textlint ignore file."
        },
        "textlint.nodePath": {
          "type": "string",
          "default": null,
          "description": "A path added to NODE_PATH when resolving the textlint module."
        },
        "textlint.run": {
          "type": "string",
          "enum": [
            "onSave",
            "onType"
          ],
          "default": "onSave",
          "description": "Run the linter on save (onSave) or on type (onType)"
        },
        "textlint.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VSCode and the textlint linter service."
        },
        "textlint.targetPath": {
          "type": "string",
          "default": "",
          "description": "A glob pattern relative to the workspace folder that selects files to lint. Leave empty to lint all supported files."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage"
  ],
  "icon": "textlint-icon_128x128.png",
  "galleryBanner": {
    "color": "#5acbe3",
    "theme": "light"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "vscode": "^1.100.0"
  }
}
